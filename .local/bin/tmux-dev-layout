#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${TMUX:-}" || -z "${TMUX_PANE:-}" ]]; then
    echo "tmux-dev-layout must be run from a tmux pane" >&2
    exit 1
fi

agent_cmd="${AGENT_CMD:-opencode2}"
editor_cmd="${MY_EDITOR:-lnvim}"
root="$PWD"
window_name="$(basename "$root")"
left="$TMUX_PANE"
window_id="$(tmux display-message -p -t "$left" '#{window_id}')"
pane_count="$(tmux list-panes -t "$window_id" -F '#{pane_id}' | wc -l | tr -d '[:space:]')"

if [[ "$pane_count" != 1 ]]; then
    echo "tmux-dev-layout requires a window with exactly one pane (found $pane_count)" >&2
    exit 1
fi

tmux rename-window -t "$window_id" "$window_name"

# Split the full-width pane first so the agent remains full height on the left.
right_top="$(
    tmux split-window -h -p 70 -t "$left" -c "$root" -P -F '#{pane_id}'
)"

tmux split-window -v -p 20 -t "$right_top" -c "$root" "$(command -v fish)"

tmux send-keys -t "$left" "$agent_cmd" Enter
tmux send-keys -t "$right_top" "$editor_cmd ." Enter
tmux select-pane -t "$left"
